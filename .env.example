# Postgres (docker-compose maps 5433 on the host to avoid clashing with a
# local install). Change POSTGRES_PASSWORD before any non-local use.
POSTGRES_PASSWORD=mkagg_dev_only
POSTGRES_PORT=5433
REDIS_PORT=6380
DATABASE_URL=postgresql://mkagg:mkagg_dev_only@localhost:5433/mkagg

# Fetcher identity. A contactable bot gets emailed, not blocked.
CRAWLER_USER_AGENT=MKPriceCompareBot/0.1 (+https://yoursite.mk/bot; bot@yoursite.mk)
CRAWLER_DEFAULT_RPS=1.0

# Salt for click_event.ip_hash. Must be set in production.
CLICK_IP_HASH_SALT=change_me
